# ─────────────────────────────────────────────────────────────────────────────
# LeadPilot configuration
#
# Minimum to run in DEMO MODE:  DATABASE_URL (+ ANTHROPIC_API_KEY & ANTHROPIC_MODEL
# for the agent). Every integration below is optional — when its keys are missing
# the app silently falls back to a built-in mock adapter and never crashes.
#
# Copy to .env.local for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection string. Neon: use the *pooled* connection string.
# Local without Postgres installed: run `pnpm db:local` and use the URL below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Max connections per server instance. Set to 1 when using `pnpm db:local` (PGlite).
DATABASE_POOL_MAX=
# Public base URL of the app (used for links in emails and the embed snippet).
APP_URL=http://localhost:3000

# ── LLM provider ─────────────────────────────────────────────────────────────
# anthropic | gemini | openai-compatible. Leave empty: the first configured of Claude
# (ANTHROPIC_API_KEY + ANTHROPIC_MODEL), Gemini (GEMINI_API_KEY + GEMINI_MODEL) and
# OpenAI-compatible (OPENAI_COMPAT_MODEL).
LLM_PROVIDER=

# ── OpenAI-compatible API (local Ollama / LM Studio, or OpenAI, Groq, OpenRouter) ─
# Default = local Ollama. LM Studio: http://localhost:1234/v1 · Groq: https://api.groq.com/openai/v1
# · OpenRouter: https://openrouter.ai/api/v1 · OpenAI: https://api.openai.com/v1
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# Not needed for local servers.
OPENAI_COMPAT_API_KEY=
# A model with tool calling, e.g. qwen3.5:9b (ollama pull qwen3.5:9b). For Ollama also set
# OLLAMA_CONTEXT_LENGTH=16384 (its default is 4k on GPUs under 24 GB) and restart Ollama.
OPENAI_COMPAT_MODEL=
# Optional thinking control sent as reasoning_effort (names are model-defined).
OPENAI_COMPAT_REASONING_EFFORT=
# Price (USD per 1M tokens) for hosted models; localhost runs are always $0. Unknown hosted
# models without a price are estimated at the top tier (may trip MAX_COST_PER_RUN_USD).
OPENAI_COMPAT_PRICE_INPUT_PER_MTOK=
OPENAI_COMPAT_PRICE_OUTPUT_PER_MTOK=
# Time budget for runs on a local model (localhost base URL). Default 300000 (5 min).
LOCAL_RUN_TIME_BUDGET_MS=300000

# ── Google Gemini ────────────────────────────────────────────────────────────
# Free key: https://aistudio.google.com/api-keys
# ⚠ Free-tier content may be used to improve Google's products — demo data only.
GEMINI_API_KEY=
# Any function-calling Gemini model available to your key, e.g. gemini-3.8-flash.
# Check which models and limits your project gets in AI Studio (rate-limit page).
GEMINI_MODEL=
# free = billed $0 (costs shown as estimates at paid rates) · paid = billing enabled.
GEMINI_TIER=free
# Comma list tried in order when the model is overloaded (503) or its daily quota is used up
# (free-tier quotas are per model). The trace shows which model served each call.
# e.g. gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=
# Gemini 3 thinking level: minimal | low | medium | high | default (= model default).
# Lowest = fastest. "minimal" exists only on 3.6/3.5 Flash and Flash-Lite; on 3.8/3.7 Flash and
# Pro it is sent as "low" (their lowest). Thinking cannot be fully turned off on Gemini 3.
GEMINI_THINKING=minimal
# Optional price override (USD per 1M tokens) for the estimate; empty = built-in table.
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=

# ── Anthropic Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model ID is never hardcoded — any tool-use capable Claude model, e.g.
# claude-opus-5 (best quality) · claude-sonnet-5 (cheaper, fast) · claude-haiku-4-5 (cheapest)
ANTHROPIC_MODEL=
# Optional pricing override (USD per million tokens) for the cost estimate.
# Leave empty to use the built-in price table for known models.
ANTHROPIC_PRICE_INPUT_PER_MTOK=
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=
# Optional reasoning effort: low | medium | high | xhigh | max. Leave empty for the
# model default (some models, e.g. Haiku 4.5, reject this parameter).
ANTHROPIC_EFFORT=

# ── Agent guardrails ─────────────────────────────────────────────────────────
# DEVELOPMENT ONLY: rule-based stand-in for Claude so you can click through the UI
# (simulate, trace, approvals) without an API key. Runs show model "dev-fake-llm".
# Refused when NODE_ENV=production. Says nothing about real model behavior.
DEV_FAKE_LLM=false

# Hard cap on model calls per run. Default 12.
MAX_AGENT_STEPS=12
# Max output tokens per model call. Default 8000.
LLM_MAX_TOKENS=8000
# A run whose accumulated estimated cost exceeds this is stopped and marked failed.
# Default 0.10. Opus-tier models with thinking can need ~0.10–0.25 for a full booking path.
MAX_COST_PER_RUN_USD=0.10
# Wall-clock budget per run in ms; keep below the API routes' maxDuration (60s). Default 50000.
# Runs still "running" a minute past their own budget are swept to "failed: timed out".
# If every action is already done and only the closing summary is cut off, the run completes with
# "Summary skipped (time budget)". pnpm agent:run (local CLI) uses 180s instead.
RUN_TIME_BUDGET_MS=50000

# ── pnpm eval pacing ─────────────────────────────────────────────────────────
# Cases run in parallel (default 1) and minimum ms between model calls (default 0).
# On the Gemini free tier, e.g. EVAL_CALL_DELAY_MS = 60000 / (your model's RPM limit) + a margin.
EVAL_CONCURRENCY=1
EVAL_CALL_DELAY_MS=0

# ── Dashboard auth ───────────────────────────────────────────────────────────
# Single admin password. When empty, the dashboard is read-only for everyone (dev only).
# PRODUCTION REFUSES TO START unless it is set, at least 12 characters, and not the
# development default "leadpilot-dev".
ADMIN_PASSWORD=
# Secret used to sign the session cookie. Required in production, 32+ characters:
#   openssl rand -hex 32
SESSION_SECRET=
# true = anonymous visitors can browse the dashboard read-only and use
# "Simulate lead" (rate-limited). Contact details are masked for visitors.
# Use it for demo deployments only — never expose real customer leads publicly.
PUBLIC_DEMO=true
# Public demo deployments: set to true so the calendar / CRM / email adapters are always
# the built-in ones, even if real integration keys are present. Real integrations are
# shown from a local run (video), never on the public URL.
PUBLIC_DEMO_FORCE_MOCK=false
# What "Simulate lead" does for public visitors (admins always run live):
#   replay = play back a recorded real run from demo/recordings.json — no model calls, $0
#            (record with `pnpm demo:record <seed...>` and commit the file)
#   live   = run the agent for real (limited by the daily budget below)
# Empty = replay when PUBLIC_DEMO=true.
DEMO_MODE=
# Global daily budget (UTC) for live "Simulate lead" runs by public visitors. When either
# limit is hit, the button shows "Demo limit reached today — watch the video".
DEMO_DAILY_RUN_LIMIT=50
DEMO_DAILY_COST_LIMIT_USD=2
# Link shown when the daily demo limit is reached (e.g. a Loom/YouTube walkthrough).
DEMO_VIDEO_URL=

# ── Adapter selection ────────────────────────────────────────────────────────
# "auto" picks the real integration when ALL its keys are present, otherwise the
# built-in one. Explicitly requested integrations with missing keys fall back too,
# with a note on the Settings page. At runtime there is never a silent fallback:
# provider errors show up in the agent trace and as a red badge in Settings.
CALENDAR_ADAPTER=auto   # auto | mock | google
CRM_ADAPTER=auto        # auto | internal | hubspot   (airtable: interface ready, not implemented)
EMAIL_ADAPTER=auto      # auto | console | resend

# ── Google Calendar (CalendarAdapter: google) ───────────────────────────────
# OAuth client of type "Desktop app" (Google Cloud Console → APIs & Services →
# Credentials). Then run `pnpm google:auth` once to obtain GOOGLE_REFRESH_TOKEN.
# ⚠ With the OAuth consent screen in "Testing" mode refresh tokens expire after
#   7 days — publish the app ("In production") for long-lived tokens (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to book into; "primary" by default (or e.g. team@yourdomain.com).
GOOGLE_CALENDAR_ID=
# Local port used by `pnpm google:auth` for the OAuth redirect. Default 53682.
GOOGLE_OAUTH_PORT=

# ── HubSpot (CRMAdapter: hubspot) ────────────────────────────────────────────
# Private App access token (Settings → Integrations → Private Apps) with scopes
# crm.objects.contacts.read and crm.objects.contacts.write.
HUBSPOT_ACCESS_TOKEN=

# ── Email (EmailAdapter: resend) ─────────────────────────────────────────────
# Sending-only API key is enough; a full-access key also enables inbound email.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Northwind Automation <hello@yourdomain.com>".
EMAIL_FROM=
# Domain that receives replies (reply+<token>@INBOUND_EMAIL_DOMAIN) so replies
# thread back to the right lead. With Resend Receiving, use your receiving domain.
INBOUND_EMAIL_DOMAIN=
# Signing secret (whsec_…) of the Resend webhook for the "email.received" event,
# pointed at https://YOUR-APP/api/inbound/email. Requires a full-access RESEND_API_KEY
# (Resend webhooks carry metadata only; the body is fetched from the API).
RESEND_WEBHOOK_SECRET=
# Alternative for Postmark / custom forwarders: shared secret for /api/inbound/email
# (?token=... or X-LeadPilot-Signature HMAC).
INBOUND_EMAIL_SECRET=
# Demo safety: seeded and simulated leads NEVER reach real providers (no emails, no
# calendar invites), even when the keys above are set.

# ── Inbound webhook ──────────────────────────────────────────────────────────
# HMAC secret for POST /api/inbound/webhook. Used when seeding the default
# workspace; can be rotated later in Settings.
WEBHOOK_SECRET=
