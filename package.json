{
  "name": "leadpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server src/server/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server src/server/db/seed.ts",
    "db:reset": "tsx --conditions=react-server src/server/db/seed.ts --reset",
    "db:studio": "drizzle-kit studio",
    "agent:run": "tsx --conditions=react-server scripts/run-agent.ts",
    "eval": "tsx --conditions=react-server evals/run.ts",
    "db:local": "pglite-server --db=./.pglite --port=5433 --max-connections=32",
    "google:auth": "tsx scripts/google-auth.ts",
    "demo:record": "tsx --conditions=react-server scripts/demo-record.ts",
    "eval:scenarios": "tsx --conditions=react-server evals/scenarios.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.34.5",
  "description": "LeadPilot — AI lead qualification & booking agent (Next.js + Claude tool use)",
  "engines": {
    "node": ">=20.9"
  }
}
